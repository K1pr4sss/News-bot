# Telegram (BotFather - new bot, separate from any old one)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Reddit (free OAuth "script" app - create at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Birdeye (free tier signup at https://birdeye.so/dashboard) - optional
# holder-count safety check. Bot runs fine without it, that one filter just
# doesn't run (RugCheck's other checks still do).
BIRDEYE_API_KEY=

# Paper trading (leave true until you're ready to wire a real wallet - see plan doc)
PAPER_TRADING=true
PAPER_STARTING_BALANCE_SOL=1.0

PORT=3100
