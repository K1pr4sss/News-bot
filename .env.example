# Telegram (BotFather - new bot, separate from any old one)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Reddit (free OAuth "script" app - create at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Solscan (free tier signup at https://solscan.io/apis) - only needed once you
# add wallet addresses to wallets.json; the bot runs fine without it, the
# insider-buy/sell signal just stays at zero.
SOLSCAN_API_KEY=

# Paper trading (leave true until you're ready to wire a real wallet - see plan doc)
PAPER_TRADING=true
PAPER_STARTING_BALANCE_SOL=1.0

PORT=3100
